{
  "name": "rpc-dart",
  "version": "0.1.1",
  "description": "TypeScript-to-Dart bindings generator for tRPC v11 backends.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rpc-dart": "bin/rpc-dart.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rpc-dart/core": "workspace:*",
    "@rpc-dart/trpc-adapter": "workspace:*",
    "@rpc-dart/dart-generator": "workspace:*",
    "jiti": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpc-dart/rpc-dart.git"
  },
  "homepage": "https://github.com/rpc-dart/rpc-dart#readme",
  "keywords": [
    "trpc",
    "dart",
    "flutter",
    "cli",
    "codegen"
  ]
}
